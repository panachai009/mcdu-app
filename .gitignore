# ==============================================================================
# MCDU TRAINER — Flutter .gitignore
# Generated: Phase 19E-H-C (2026-09-27)
# Replaces default Flutter scaffold .gitignore with project-safe rules.
# ==============================================================================

# ------------------------------------------------------------------------------
# PROPRIETARY / REFERENCE DOCUMENTS — must never be committed
# These files are development reference material only.
# Neither file is declared in pubspec.yaml.
# Neither file is loaded at runtime (confirmed by Phase 19E-H-B audit).
# Do NOT delete them locally — keep as reference documents.
# ------------------------------------------------------------------------------
assets/pdf/

# ------------------------------------------------------------------------------
# UNDECLARED DUPLICATE ASSET — not referenced by any Dart code
# Identical copy of assets/images/MCDU UI.jpg at the project root.
# Not declared in pubspec.yaml. Not loaded at runtime.
# The canonical copy in assets/images/ is intentionally NOT ignored.
# ------------------------------------------------------------------------------
/MCDU UI.jpg

# ------------------------------------------------------------------------------
# FLUTTER / DART BUILD ARTIFACTS
# Generated by `flutter build` and `dart pub get`. Never commit these.
# ------------------------------------------------------------------------------
/build/
/coverage/
.dart_tool/
.pub/
.pub-cache/
.flutter-plugins
.flutter-plugins-dependencies

# Generated API documentation
**/doc/api/

# Symbolication / obfuscation maps
app.*.symbols
app.*.map.json

# Widget preview (Flutter tool generated)
.widget_preview/

# ------------------------------------------------------------------------------
# ANDROID — machine-specific configuration
# android/local.properties contains the absolute path to the Flutter SDK
# on the local machine (flutter.sdk=C:\src\flutter).
# Committing this breaks builds on any other machine.
# ------------------------------------------------------------------------------
android/local.properties
/android/app/debug
/android/app/profile
/android/app/release

# ------------------------------------------------------------------------------
# iOS — generated files containing machine-specific absolute paths
# These files contain FLUTTER_ROOT and FLUTTER_APPLICATION_PATH pointing
# to this machine's D:\MCDU APP and C:\src\flutter.
# They are auto-regenerated on each `flutter build ios` / `flutter run`.
# ------------------------------------------------------------------------------
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/Flutter/ephemeral/
**/ios/Flutter/.last_build_id

# ------------------------------------------------------------------------------
# IDE — IntelliJ / Android Studio
# .idea/ contains machine-specific SDK paths (Dart SDK XML with C:\src\flutter).
# *.iml files are machine-specific IntelliJ module descriptors.
# ------------------------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws

# ------------------------------------------------------------------------------
# IDE — VS Code
# Uncomment the line below if the team shares VS Code launch configs.
# Leave commented to allow .vscode/ to be committed if desired.
# ------------------------------------------------------------------------------
.vscode/

# ------------------------------------------------------------------------------
# MISCELLANEOUS — OS, editor, and tool temporary files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Editor temporaries
*.swp
*.swo
*~
*.orig

# Logs and crash dumps
*.log
*.pyc
*.class

# IntelliJ build artifacts
.build/
.buildlog/

# Version control system artifacts
.svn/
.history

# Swift Package Manager (iOS toolchain)
.swiftpm/

# Migration tool working directory
migrate_working_dir/

# Android Studio release artifacts
*.ipr

# ------------------------------------------------------------------------------
# NOTE: assets/images/MCDU UI.jpg is intentionally NOT ignored.
# It is a declared pubspec.yaml asset and a runtime dependency.
# Publication decision deferred to a later phase.
# ------------------------------------------------------------------------------
